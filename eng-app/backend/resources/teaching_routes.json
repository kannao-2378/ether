{
  "course_id": "foundation",
  "units": [
    {
      "id": "route-actions",
      "title": "日常动作",
      "goal": "先表达做什么，再组成带 I 的简单句。",
      "position": 0
    },
    {
      "id": "route-intentions",
      "title": "状态、需求与计划",
      "goal": "表达自己的状态、想法与打算。",
      "position": 1
    },
    {
      "id": "route-activities",
      "title": "喜好与持续学习",
      "goal": "区分 to 后的基本写法和 -ing 写法。",
      "position": 2
    },
    {
      "id": "route-interaction",
      "title": "与人和事物互动",
      "goal": "表达听、看、等、交谈和请求。",
      "position": 3
    },
    {
      "id": "route-views",
      "title": "能力、情绪与看法",
      "goal": "说明擅长什么、担心什么和同意谁。",
      "position": 4
    },
    {
      "id": "route-time",
      "title": "时间与日常安排",
      "goal": "给已会的句子补上时间信息。",
      "position": 5
    },
    {
      "id": "route-space",
      "title": "位置与数量",
      "goal": "说明位置和数量。",
      "position": 6
    },
    {
      "id": "route-connections",
      "title": "原因、打算与过去习惯",
      "goal": "用已学表达说明原因、将来打算与过去习惯。",
      "position": 7
    }
  ],
