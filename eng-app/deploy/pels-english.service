[Unit]
Description=Personal English Learning System
After=network.target

[Service]
Type=simple
User=pels
Group=pels
WorkingDirectory=/opt/pels/backend
EnvironmentFile=/etc/pels/english.env
Environment=PELS_AUTH_ENABLED=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/pels/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pels

[Install]
WantedBy=multi-user.target
